ad: P2 lee precio y stock de D1 para avisar de cambios; P4 reserva stock en D1 al confirmar." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1000" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v3" name="3 · Diagrama de flujo · checkout todo o nada"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="IndiConnect — Diagrama de flujo del checkout «todo o nada» (bloques A3 y A4, CA-03 a CA-05)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1100" height="24" as="geometry"/></mxCell><mxCell id="c2" value="Solo se cobra si todas las marcas confirman su subpedido · Terminal = óvalo · Paso = rectángulo · Decisión = rombo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="1100" height="20" as="geometry"/></mxCell><mxCell id="c3" value="El cliente pulsa «Pagar»" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#ffffff;strokeColor=#333333;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="300" height="44" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Revalidar precio y stock&lt;/b&gt;&lt;br&gt;del carrito completo · A3·P1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="300" height="56" as="geometry"/></mxCell><mxCell id="c5" value="¿Precio y stock&lt;br&gt;siguen válidos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="250" width="240" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Autorizar el pago simulado&lt;/b&gt;&lt;br&gt;con clave de idempotencia · A3·P6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="380" width="300" height="56" as="geometry"/></mxCell><mxCell id="c7" value="¿Pago&lt;br&gt;autorizado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="470" width="240" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Crear pedido y subpedidos&lt;/b&gt;&lt;br&gt;uno por marca, en una transacción · A4·P1, P2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="600" width="300" height="56" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Pedir confirmación a cada marca&lt;/b&gt;&lt;br&gt;y verificar totales · A4·P3.1, P3.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="690" width="300" height="56" as="geometry"/></mxCell><mxCell id="c10" value="¿Confirman todas&lt;br&gt;y cuadran totales?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#1f5fbf;strokeWidth=3;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="780" width="260" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Guardar todo y capturar el pago&lt;/b&gt;&lt;br&gt;reservar stock y calcular comisión · A4·P3.3, P4, P5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="920" width="300" height="56" as="geometry"/></mxCell><mxCell id="c12" value="Pedido confirmado (W-A4-1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=